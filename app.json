{
  "expo": {
    "name": "TailorPro",
    "slug": "tailorpro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tailorpro",
    "userInterfaceStyle": "automatic",
    "notification": {
      "color": "#16123A",
      "androidMode": "default",
      "androidCollapsedTitle": "TailorPro"
    },
    "splash": {
      "image": "./assets/logo/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#6B21A8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tailorpro.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/logo.png",
        "backgroundColor": "#6B21A8"
      },
      "package": "com.tailorpro.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#16123A",
          "defaultChannel": "atelier",
          "sounds": [],
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TailorPro to access your camera for taking photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TailorPro to access your photos.",
          "cameraPermission": "Allow TailorPro to access your camera for taking photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow TailorPro to access your location."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3fda2270-9a15-4b79-b964-929b10e9ebb4"
      }
    }
  }
}
