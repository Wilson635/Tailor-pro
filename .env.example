# ==========================================
# CONFIGURATION FIREBASE - TailorPro
# ==========================================

# Firebase Web App Configuration
# Obtenir ces valeurs depuis la console Firebase:
# https://console.firebase.google.com/
# Project Settings > General > Your apps > Firebase SDK snippet
# google = project-782244975825

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# ==========================================
# INSTRUCTIONS DE CONFIGURATION
# ==========================================
# 
# 1. Créez un projet Firebase sur https://console.firebase.google.com/
# 2. Activez Authentication avec Email/Password
# 3. Créez une base de données Firestore
# 4. Activez Firebase Storage
# 5. Copiez les valeurs de configuration depuis Project Settings
# 6. Renommez ce fichier en .env et remplissez les valeurs
#
# ==========================================
